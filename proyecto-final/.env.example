# Copiar a .env y ajustar los valores.
# .env nunca debe subirse al repositorio.

APP_ENV=development
APP_NAME="DevStudio"
APP_URL=http://localhost:8080
APP_TIMEZONE=America/Mexico_City
WEB_PORT=8080

# Datos públicos de la empresa (se muestran en el sitio y en GET /config)
COMPANY_TAGLINE="Claridad para tu negocio, sin que sepas de sistemas"
COMPANY_DESCRIPTION="Acompañamos a empresas de Puebla a conseguir clientes, ordenar la operación y atender desde el teléfono."
COMPANY_EMAIL=contacto@devstudio.local
COMPANY_PHONE="+52 222 000 0000"
COMPANY_WHATSAPP="+52 222 000 0000"
COMPANY_ADDRESS="Puebla, México"
COMPANY_HOURS="Lunes a viernes, 9:00 a 18:00"
COMPANY_LINKEDIN=
COMPANY_GITHUB=
COMPANY_INSTAGRAM=

# SQL Server
DB_HOST=mssql
DB_PORT=1433
DB_NAME=DevStudioDB
DB_USER=sa
# SQL Server exige mayúsculas, minúsculas, número y símbolo (mínimo 8 caracteres).
DB_PASSWORD="CambiaEstaClave#2026"
DB_ENCRYPT=true
# true solo en desarrollo; en producción debe ser false con certificado válido.
DB_TRUST_CERT=true

# Sesiones
SESSION_NAME=devstudio_session
SESSION_SECURE=false
SESSION_SAMESITE=Lax

# API
API_PREFIX=/api/v1

# Administrador inicial (solo para backEnd/scripts/crear-admin.php)
ADMIN_NAME="Administrador"
ADMIN_EMAIL=admin@devstudio.local
ADMIN_PASSWORD="Admin#2026"

# Opcional: carpeta del rate limit de login (por defecto en sys_get_temp_dir)
# RATE_LIMIT_DIR=/tmp/devstudio-rate-limit
